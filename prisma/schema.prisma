generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  name        String?
  password    String
  isActive    Boolean     @default(true) @map("is_active")
  hasPassword Boolean     @default(true) @map("has_password")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  roles       UserRole[]
  invite      UserInvite?

  @@map("users")
}

model UserInvite {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  token     String   @unique
  expiredAt DateTime @map("expired_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invites")
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  module      String
  action      String
  label       String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model WorkflowModule {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("workflow_modules")
}

// ─── Bank Statement Module ────────────────────────────────────────────────────

model BankAccount {
  id            String   @id @default(uuid())
  accountNumber String   @unique @map("account_number")
  accountName   String   @map("account_name")
  bankName      String   @map("bank_name")
  currency      String
  countryCode   String   @map("country_code")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  syncJobAccounts BankSyncJobAccount[]
  transactions    BankTransaction[]

  @@map("bank_accounts")
}

model BankSyncJob {
  id           String    @id @default(uuid())
  status       String    @default("pending")
  triggeredBy  String?   @map("triggered_by")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message")
  logs         Json      @default("[]")
  steps        Json      @default("[]")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")

  accountJobs  BankSyncJobAccount[]
  transactions BankTransaction[]

  @@map("bank_sync_jobs")
}

model BankSyncJobAccount {
  id             String   @id @default(uuid())
  jobId          String   @map("job_id")
  bankAccountId  String   @map("bank_account_id")
  status         String   @default("pending")
  rowsDownloaded Int      @default(0) @map("rows_downloaded")
  rowsInserted   Int      @default(0) @map("rows_inserted")
  rowsDuplicate  Int      @default(0) @map("rows_duplicate")
  rowsSynced     Int      @default(0) @map("rows_synced")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  job         BankSyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@map("bank_sync_job_accounts")
}

model BankTransaction {
  id                String   @id @default(uuid())
  bankAccountId     String   @map("bank_account_id")
  jobId             String   @map("job_id")
  postDate          DateTime @map("post_date")
  narrative         String?
  bankReference     String?  @map("bank_reference")
  customerReference String?  @map("customer_reference")
  trnType           String?  @map("trn_type")
  creditAmount      Decimal? @map("credit_amount") @db.Decimal(18, 2)
  debitAmount       Decimal? @map("debit_amount") @db.Decimal(18, 2)
  balance           Decimal? @db.Decimal(18, 2)
  dataHash          String   @map("data_hash")
  rawData           Json     @map("raw_data")
  createdAt         DateTime @default(now()) @map("created_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  job         BankSyncJob @relation(fields: [jobId], references: [id])

  @@unique([bankAccountId, dataHash])
  @@map("bank_transactions")
}

model BankDownloadTemplate {
  id         String   @id @default(uuid())
  name       String   @unique
  headers    Json
  headerHash String   @map("header_hash")
  isActive   Boolean  @default(true) @map("is_active")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("bank_download_templates")
}

model BankCountryMapping {
  id          String   @id @default(uuid())
  companyName String   @unique @map("company_name")
  countryCode String   @map("country_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("bank_country_mappings")
}

model BankGsheetConfig {
  id                String   @id @default(uuid())
  countryCode       String   @unique @map("country_code")
  spreadsheetId     String   @map("spreadsheet_id")
  spreadsheetUrl    String?  @map("spreadsheet_url")
  templateSheetName String?  @map("template_sheet_name")
  serviceKeyJson    String?  @map("service_key_json")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("bank_gsheet_configs")
}

model BankJobSettings {
  id                          String   @id @default(uuid())
  scheduleCron                String   @default("30 9 * * *") @map("schedule_cron")
  isScheduled                 Boolean  @default(true) @map("is_scheduled")
  hsbcnetUsername             String?  @map("hsbcnet_username")
  googleServiceKeyJson        String?  @map("google_service_key_json")
  googleTemplateSpreadsheetId String?  @map("google_template_spreadsheet_id")
  googleTemplateSheet         String?  @map("google_template_sheet")
  syncDateMode                String   @default("yesterday") @map("sync_date_mode")
  syncCustomDays              Int      @default(1) @map("sync_custom_days")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  createdAt                   DateTime @default(now()) @map("created_at")

  @@map("bank_job_settings")
}

model ArGsheetConfig {
  id             String   @id @default(uuid())
  countryCode    String   @unique @map("country_code")
  spreadsheetId  String   @map("spreadsheet_id")
  sheetName      String   @default("TH") @map("sheet_name")
  spreadsheetUrl String?  @map("spreadsheet_url")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ar_gsheet_configs")
}

model ArReportSettings {
  id                   String   @id @default(uuid())
  googleServiceKeyJson String?  @map("google_service_key_json")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("ar_report_settings")
}

model SystemSettings {
  id                   String   @id
  googleServiceKeyJson String?  @map("google_service_key_json")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}
