generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int              @id @default(autoincrement())
  email         String           @unique
  name          String?
  password      String
  isActive      Boolean          @default(true) @map("is_active")
  hasPassword   Boolean          @default(true) @map("has_password")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  roles         UserRole[]
  permissions   UserPermission[]
  invite        UserInvite?
  passwordReset PasswordReset?
  notifications Notification[]
  gasLinks      GasLink[]

  @@map("users")
}

model UserInvite {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  token     String   @unique
  expiredAt DateTime @map("expired_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invites")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  token     String   @unique
  expiredAt DateTime @map("expired_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  name        String
  group       String?
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  module      String
  action      String
  label       String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]
  users       UserPermission[]

  @@map("permissions")
}

model UserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Permissions assigned directly to a user, additive with role-derived permissions — used for per-module overrides
model UserPermission {
  userId       Int        @map("user_id")
  permissionId Int        @map("permission_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// ─── Bank Statement Module ────────────────────────────────────────────────────

// Master data — declared account names (as they appear in HSBCnet). Added manually
// (seed / future admin UI), never auto-created by the sync job. Discovery only
// creates BankAccount rows for account names that already exist here.
model BankAccountName {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  accountCode String   @map("account_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  accounts BankAccount[]

  @@map("bank_account_names")
}

model BankAccount {
  id             Int      @id @default(autoincrement())
  accountNumber  String   @unique @map("account_number")
  accountNameId  Int      @map("account_name_id")
  accountName    String   @map("account_name")
  bankName       String   @map("bank_name")
  currency       String
  accountCode    String   @map("account_code")
  isActive       Boolean   @default(true) @map("is_active")
  // User intent — separate from isActive, which HSBC discovery owns and silently
  // resets to true whenever it still sees this account number. This is the actual
  // "should the sync job fetch this account" toggle a user controls (e.g. to test
  // with only a subset of accounts) without discovery undoing it on the next run.
  syncEnabled    Boolean   @default(true) @map("sync_enabled")
  createdAt      DateTime  @default(now()) @map("created_at")
  // Bounds of the most recent successful fetch — a future run whose [from,to] request
  // falls entirely within [lastSyncedFrom, lastSyncedTo] can skip re-downloading, since
  // that data is already confirmed final. Both bounds matter: checking lastSyncedTo
  // alone would wrongly skip a WIDER range whose earlier start was never actually
  // fetched (e.g. a single-day "yesterday" job followed by a "last 7 days" job).
  // Simply overwritten (not merged) after each real fetch, not accumulated across gaps —
  // safe default if the new range doesn't connect to the old one is to re-fetch more
  // than strictly needed, never to wrongly skip something never confirmed.
  lastSyncedFrom DateTime? @map("last_synced_from")
  lastSyncedTo   DateTime? @map("last_synced_to")

  accountNameRef  BankAccountName      @relation(fields: [accountNameId], references: [id])
  syncJobAccounts BankSyncJobAccount[]
  transactions    BankTransaction[]

  @@map("bank_accounts")
}


model BankSyncJob {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @map("public_id")
  status       String    @default("pending")
  triggeredBy  String?   @map("triggered_by")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message")
  logs         Json      @default("[]")
  steps        Json      @default("[]")
  durationMsTotal Int    @default(0) @map("duration_ms_total")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  // Optional per-run override — set only when a user picks an explicit date range on
  // manual "Run now" (not persisted to BankJobSettings). Null means "use the default
  // syncDateMode/syncCustomDays settings", same as before this existed.
  dateFromOverride DateTime? @map("date_from_override")
  dateToOverride   DateTime? @map("date_to_override")
  // The ACTUAL date range HSBC was queried with for this run — set by the worker
  // once computed (whether from the override above or from syncDateMode/syncCustomDays),
  // so the UI can show it directly instead of parsing it out of the log text.
  dateRangeFrom    DateTime? @map("date_range_from")
  dateRangeTo      DateTime? @map("date_range_to")

  accountJobs  BankSyncJobAccount[]
  transactions BankTransaction[]

  @@map("bank_sync_jobs")
}

model BankSyncJobAccount {
  id               Int      @id @default(autoincrement())
  jobId            Int      @map("job_id")
  bankAccountId    Int      @map("bank_account_id")
  status           String   @default("pending") // download status: pending | completed | failed
  rowsDownloaded   Int      @default(0) @map("rows_downloaded")
  rowsInserted     Int      @default(0) @map("rows_inserted")
  rowsDuplicate    Int      @default(0) @map("rows_duplicate")
  rowsSynced       Int      @default(0) @map("rows_synced")
  errorMessage     String?  @map("error_message")
  sheetsSyncStatus String   @default("pending") @map("sheets_sync_status") // pending | completed | failed | skipped
  sheetsSyncError  String?  @map("sheets_sync_error")
  createdAt        DateTime @default(now()) @map("created_at")

  job         BankSyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([jobId, bankAccountId])
  @@map("bank_sync_job_accounts")
}

model BankTransaction {
  id                Int      @id @default(autoincrement())
  bankAccountId     Int      @map("bank_account_id")
  jobId             Int      @map("job_id")
  postDate          DateTime @map("post_date")
  narrative         String?
  bankReference     String?  @map("bank_reference")
  customerReference String?  @map("customer_reference")
  trnType           String?  @map("trn_type")
  creditAmount      Decimal? @map("credit_amount") @db.Decimal(18, 2)
  debitAmount       Decimal? @map("debit_amount") @db.Decimal(18, 2)
  balance           Decimal? @db.Decimal(18, 2)
  dataHash          String   @map("data_hash")
  rawData           Json     @map("raw_data")
  createdAt         DateTime @default(now()) @map("created_at")
  // Every job that has ever fetched this row — the original inserting job (jobId) plus
  // every later job that re-fetched an overlapping range and matched it as a duplicate.
  // Force Resync uses this (not jobId alone) so a job can still manage/re-push data it
  // has seen even if the original inserting job was since deleted.
  jobIds            Int[]    @default([]) @map("job_ids")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  job         BankSyncJob @relation(fields: [jobId], references: [id])

  @@unique([bankAccountId, dataHash])
  @@map("bank_transactions")
}

model BankDownloadTemplate {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  headers    Json
  headerHash String   @map("header_hash")
  isActive   Boolean  @default(true) @map("is_active")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("bank_download_templates")
}

model BankGsheetConfig {
  id                Int      @id @default(autoincrement())
  accountCode       String   @unique @map("account_code")
  spreadsheetId     String   @map("spreadsheet_id")
  spreadsheetUrl    String?  @map("spreadsheet_url")
  templateSheetName String?  @map("template_sheet_name")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("bank_gsheet_configs")
}

model GasLink {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  icon        String
  description String?
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@map("gas_links")
}

model BankJobSettings {
  id                          String   @id
  scheduleCron                String   @default("30 9 * * *") @map("schedule_cron")
  isScheduled                 Boolean  @default(true) @map("is_scheduled")
  hsbcnetUsername             String?  @map("hsbcnet_username")
  googleTemplateSpreadsheetId String?  @map("google_template_spreadsheet_id")
  googleTemplateSheet         String?  @map("google_template_sheet")
  syncDateMode                String   @default("yesterday") @map("sync_date_mode")
  syncCustomDays              Int      @default(1) @map("sync_custom_days")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  createdAt                   DateTime @default(now()) @map("created_at")

  @@map("bank_job_settings")
}

model ArGsheetConfig {
  id             Int      @id @default(autoincrement())
  countryCode    String   @unique @map("country_code")
  spreadsheetId  String   @map("spreadsheet_id")
  sheetName      String   @default("TH") @map("sheet_name")
  spreadsheetUrl String?  @map("spreadsheet_url")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ar_gsheet_configs")
}

model ArReportSettings {
  id                   String   @id
  googleServiceKeyJson String?  @map("google_service_key_json")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("ar_report_settings")
}

model CurrencyRate {
  currency  String   @id
  rateToUsd Decimal  @map("rate_to_usd")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("currency_rates")
}

model CurrencySettings {
  id            String    @id @default("default")
  autoUpdateDay Int       @default(1) @map("auto_update_day")
  lastUpdatedAt DateTime? @map("last_updated_at")
  nextUpdateAt  DateTime? @map("next_update_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("currency_settings")
}

model SystemSettings {
  id                   String   @id
  googleServiceKeyJson String?  @map("google_service_key_json")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

// ─── Notifications (bell) ─────────────────────────────────────────────────────

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   // job_completed | job_failed | job_waiting_2fa
  title       String
  body        String?
  jobPublicId String?  @map("job_public_id") // BankSyncJob.publicId — matches the /bank-statement/jobs/:id route
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Reconcile Module ──────────────────────────────────────────────────────────

// Master Customer brand -> customer-name lookup, replaced wholesale via the
// Reconcile page's "Cập nhật lại" upload (rarely changes).
model MasterCustomerMapping {
  id           Int      @id @default(autoincrement())
  brandName    String   @unique @map("brand_name")
  customerName String   @map("customer_name")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("master_customer_mappings")
}

// Column-mapping "setup" for the Filter & Merge tool — rarely changes, edited from
// Settings > Reconcile rather than on the tool's run page.
model ReconcileSettings {
  id             String   @id @default("default")
  headerRow      Int      @default(1) @map("header_row")
  salesColumn    String   @default("Doanh số bán chưa thuế VNĐ") @map("sales_column")
  taxColumn      String   @default("Thuế GTGT đầu ra VNĐ") @map("tax_column")
  noteColumn     String   @default("Ghi chú") @map("note_column")
  customerColumn String   @default("Tên khách hàng") @map("customer_column")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("reconcile_settings")
}
