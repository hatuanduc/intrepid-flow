API_BASE_URL=http://localhost:4000

# Optional fallback (build-time) for local/dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Google OAuth Web client ID (Sign in with Google) — cùng giá trị với root .env's
# GOOGLE_CLIENT_ID. Next.js chỉ đọc env từ apps/web/, không đọc .env ở repo root,
# nên cần khai báo lại ở đây cho local dev. Để trống thì nút Google tự ẩn.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
