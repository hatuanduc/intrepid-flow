{
  "name": "@intrepid/reconcile-lambda",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --external:@aws-sdk/*",
    "zip": "pnpm build && cd dist && rm -f function.zip && zip -q function.zip index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "exceljs": "^4.4.0",
    "saxes": "^5.0.1",
    "unzipper": "^0.10.14"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20",
    "@types/unzipper": "^0.10.11",
    "esbuild": "^0.24.0",
    "typescript": "^5.8.3"
  }
}
