# Server
PORT=4000

# Database (Prisma)
# Pooled connection — thêm ?pgbouncer=true để tránh lỗi prepared statements với Supabase pgBouncer
DATABASE_URL=postgresql://user:password@host:6543/postgres?schema=public&pgbouncer=true
# Direct connection — dùng cho migrate/generate (không qua pooler)
DIRECT_URL=postgresql://user:password@host:5432/postgres?schema=public

# Auth
JWT_SECRET=change-me-in-production
