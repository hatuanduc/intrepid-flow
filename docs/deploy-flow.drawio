<mxfile host="VSCode" version="21.0.8">
  <diagram id="cicd" name="1. CI/CD Pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="p1-title" value="Deploy Flow — GitHub Actions + AWS"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;fontColor=#1a1f36;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="16" width="500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1-sub" value="No SSH. No ECR. Images built on EC2. Secrets from SSM. Deployment via SSM Run Command."
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#697386;fontStyle=2;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="52" width="620" height="18" as="geometry" />
        </mxCell>

        <!-- ====== TRIGGERS ====== -->
        <mxCell id="p1-push" value="&lt;b&gt;Push&lt;/b&gt; to &lt;b&gt;main&lt;/b&gt; → env: prod&lt;br&gt;&lt;b&gt;Push&lt;/b&gt; to &lt;b&gt;develop&lt;/b&gt; → env: dev"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1f36;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="86" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p1-pr" value="&lt;b&gt;Pull Request&lt;/b&gt; to main / develop (infra paths only)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0effe;strokeColor=#c7d2fe;fontColor=#635bff;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="156" width="260" height="40" as="geometry" />
        </mxCell>

        <!-- concurrency note -->
        <mxCell id="p1-concur" value="concurrency: 1 run/branch (queued, not cancelled)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#697386;fontStyle=2;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="204" width="260" height="16" as="geometry" />
        </mxCell>

        <!-- ====== JOB 1: infra ====== -->
        <mxCell id="p1-infra-bg" value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;opacity=50;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="230" width="260" height="342" as="geometry" />
        </mxCell>
        <mxCell id="p1-infra-lbl" value="Job 1: &lt;b&gt;infra&lt;/b&gt;   role: &lt;b&gt;infra-manager&lt;/b&gt; (OIDC)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#92400e;"
          vertex="1" parent="1">
          <mxGeometry x="38" y="236" width="280" height="18" as="geometry" />
        </mxCell>

        <mxCell id="p1-i1" value="① Checkout (fetch-depth: 2)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="260" width="232" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-i2" value="② AWS OIDC → assume infra-manager role"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="300" width="232" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-i3" value="③ terraform init  (env: prod | dev)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="340" width="232" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-i4" value="④ Detect infra changes (git diff HEAD~1)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="380" width="232" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-i5" value="⑤ terraform validate + plan  (if changed)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#fcd34d;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="420" width="232" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-i6" value="⑥ terraform apply --auto-approve  (if push + changed)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fcd34d;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="460" width="232" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-i7" value="⑦ Output: instance_id  (terraform output -raw)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="508" width="232" height="32" as="geometry" />
        </mxCell>

        <!-- ====== JOB 2: deploy ====== -->
        <mxCell id="p1-deploy-bg" value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=50;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="260" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p1-deploy-lbl" value="Job 2: &lt;b&gt;deploy&lt;/b&gt;   role: &lt;b&gt;{env}-deploy-role&lt;/b&gt; (OIDC, push only)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#065f46;"
          vertex="1" parent="1">
          <mxGeometry x="38" y="626" width="300" height="18" as="geometry" />
        </mxCell>

        <mxCell id="p1-d1" value="① Checkout"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="650" width="232" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-d2" value="② AWS OIDC → assume {env}-deploy-role"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="690" width="232" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1-d3" value="③ Tarball repo (no .git/node_modules/.next) → S3&lt;br&gt;Key: deploy/{env}/{git-sha}.tar.gz"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="730" width="232" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p1-d4" value="④ SSM RunCommand: s3 cp + run deploy.sh"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fcd34d;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="780" width="232" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-d5" value="⑤ Poll SSM status every 15s (max 20 min)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="44" y="828" width="232" height="32" as="geometry" />
        </mxCell>

        <!-- ====== S3 ====== -->
        <mxCell id="p1-s3" value="&lt;b&gt;S3&lt;/b&gt; intrepid-terraform-state&lt;br&gt;deploy/{env}/{git-sha}.tar.gz&lt;br&gt;+ {env}/terraform.tfstate"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;fontSize=11;boundedLbl=1;backgroundOutline=1;size=10;"
          vertex="1" parent="1">
          <mxGeometry x="400" y="360" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- ====== EC2 EXECUTION ====== -->
        <mxCell id="p1-ec2-bg" value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=50;"
          vertex="1" parent="1">
          <mxGeometry x="400" y="620" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p1-ec2-lbl" value="EC2 Instance — &lt;b&gt;deploy.sh&lt;/b&gt;  (via SSM, no SSH)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#5b21b6;"
          vertex="1" parent="1">
          <mxGeometry x="408" y="626" width="280" height="18" as="geometry" />
        </mxCell>

        <mxCell id="p1-e1" value="① Bootstrap gate: wait for Docker (first boot only)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="414" y="650" width="252" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-e2" value="② SSM GetParameters /intrepid/{env}/* → /app/.env"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#e3e8ee;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="414" y="698" width="252" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-e3" value="③ docker compose up --build -d --wait --wait-timeout 300"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fcd34d;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="414" y="746" width="252" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-e4" value="④ All healthchecks pass → containers running"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="414" y="794" width="252" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-e5" value="⑤ SSM reports success → GitHub Actions ✓"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="414" y="842" width="252" height="28" as="geometry" />
        </mxCell>

        <!-- ====== DOCKER CONTAINERS ====== -->
        <mxCell id="p1-docker-bg" value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=50;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="640" width="170" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p1-docker-lbl" value="Docker containers"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#1e40af;"
          vertex="1" parent="1">
          <mxGeometry x="768" y="646" width="155" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p1-dc1" value="db  PostgreSQL 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#f8cecc;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="772" y="668" width="144" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p1-dc2" value="redis  Redis 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#fcd34d;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="772" y="700" width="144" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p1-dc3" value="api  NestJS :4000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0effe;strokeColor=#c7d2fe;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="772" y="732" width="144" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p1-dc4" value="web  Next.js :3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0effe;strokeColor=#c7d2fe;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="772" y="764" width="144" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p1-dc5" value="worker  BankSync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="772" y="796" width="144" height="26" as="geometry" />
        </mxCell>

        <!-- ====== EDGES ====== -->

        <!-- Push → infra -->
        <mxCell id="p1-ef1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="p1-push" target="p1-infra-bg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PR → plan (dashed) -->
        <mxCell id="p1-ef-pr" value="plan only (no apply)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=10;strokeColor=#635bff;fontColor=#635bff;"
          edge="1" source="p1-pr" target="p1-i5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- infra → deploy (depends_on) -->
        <mxCell id="p1-ef2" value="needs: infra" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontStyle=1;" edge="1" source="p1-infra-bg" target="p1-deploy-bg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- tarball → S3 -->
        <mxCell id="p1-ef3" value="upload" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;strokeColor=#d97706;fontColor=#92400e;" edge="1" source="p1-d3" target="p1-s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3 → EC2 (download) -->
        <mxCell id="p1-ef6" value="s3 cp" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;strokeColor=#d97706;fontColor=#92400e;" edge="1" source="p1-s3" target="p1-e1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSM RunCommand → EC2 -->
        <mxCell id="p1-ef4" value="SSM Run Command" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#9673a6;fontColor=#5b21b6;strokeWidth=2;" edge="1" source="p1-d4" target="p1-e1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- docker compose → containers -->
        <mxCell id="p1-ef7" value="builds &amp; starts" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#6c8ebf;fontColor=#1e40af;strokeWidth=2;" edge="1" source="p1-e3" target="p1-docker-bg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSM poll feedback -->
        <mxCell id="p1-ef8" value="status poll (15s)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;strokeColor=#9673a6;fontColor=#5b21b6;" edge="1" source="p1-e5" target="p1-d5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

