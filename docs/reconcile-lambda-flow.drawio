<mxfile host="app.diagrams.net">

  <!-- PAGE 1 — Architecture & Data Flow -->
  <diagram name="1. Architecture" id="reconcile-arch">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="title" value="Reconcile &quot;Filter &amp; Merge&quot; — Lambda Offload Architecture"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a1f36;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Invoice parsing runs in AWS Lambda instead of a forked child process on the shared EC2 host — see apps/reconcile-lambda/src/handler.ts"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#697386;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry"/>
        </mxCell>

        <!-- Band labels -->
        <mxCell id="band1-lbl" value="① START JOB  (synchronous — API request/response)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#635bff;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="500" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="band2-lbl" value="② LAMBDA RUNS  (async — apps/reconcile-lambda, no VPC, no DB access)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="600" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="band3-lbl" value="③ POLL &amp; DOWNLOAD  (browser polls every 3s, gives up after 11 min)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;fontColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="600" height="18" as="geometry"/>
        </mxCell>

        <!-- ===== BAND 1: START JOB ===== -->

        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;ReconcilePage.tsx"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1f36;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="112" width="140" height="64" as="geometry"/>
        </mxCell>

        <mxCell id="api1" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;NestJS — ReconcileService&lt;br&gt;(runs on EC2, shared w/ web/worker/db/redis)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#635bff;strokeColor=#4f46e5;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="104" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="pg1" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;ReconcileSettings&lt;br&gt;MasterCustomerMapping"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1f36;fontSize=11;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s3-1" value="S3" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="52" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="s3-1-detail" value="reconcile bucket&#xa;input/{jobId}/0-*.xlsx&#xa;input/{jobId}/1-*.xlsx ..." style="text;html=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="112" width="190" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="lambda-1" value="Lambda" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#E7157B;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="52" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="lambda-1-detail" value="reconcile function&#xa;arm64 · 6GB · 10min timeout" style="text;html=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1020" y="118" width="190" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="e-b-api" value="POST /filter-merge&#xa;(multipart upload, ≤5 files)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" source="browser" target="api1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-api-b" value="202 { jobId }" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;strokeColor=#059669;fontColor=#059669;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" source="api1" target="browser" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-api-pg" value="read settings +&#xa;master customer map" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="api1" target="pg1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-api-s3" value="PutObject&#xa;(each uploaded file)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#7AA116;fontColor=#7AA116;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" source="api1" target="s3-1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-api-lam" value="InvokeCommand&#xa;(InvocationType: Event — async)&#xa;payload: settings + masterMap + S3 keys" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#E7157B;fontColor=#E7157B;exitX=1;exitY=0.65;entryX=0;entryY=0.5;" edge="1" source="api1" target="lambda-1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== BAND 2: LAMBDA RUNS ===== -->

        <mxCell id="lambda-box" value="apps/reconcile-lambda/src/handler.ts&#xa;&#xa;Pass 1 — for each input file: GetObject → parse → accumulate&#xa;totals + aggregates only (detail rows discarded, small &amp; bounded)&#xa;&#xa;Write Summary sheet + Detail sheet's TOTAL rows&#xa;(needs pass 1's final totals before any detail row can be written)&#xa;&#xa;Pass 2 — re-GetObject each file, stream its matching rows&#xa;straight into the Detail sheet, one file at a time&#xa;(peak memory = biggest single file, not the whole batch)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#E7157B;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="380" y="360" width="480" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="s3-2" value="S3" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="370" width="52" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="s3-2-detail-ok" value="on success:&#xa;output/{jobId}.xlsx&#xa;metadata: output-filename" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="960" y="430" width="220" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s3-2-detail-err" value="on failure:&#xa;output/{jobId}.xlsx.error.json&#xa;{ message }" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#b91c1c;" vertex="1" parent="1">
          <mxGeometry x="960" y="480" width="220" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="e-s3-lam" value="GetObject ×2 per file&#xa;(pass 1 + pass 2)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#7AA116;fontColor=#7AA116;exitX=0.5;exitY=1;exitDx=-100;entryX=0.5;entryY=1;entryDx=140;" edge="1" source="s3-1" target="lambda-box" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="230"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-lam-s3ok" value="PutObject (success)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#059669;fontColor=#059669;exitX=1;exitY=0.3;entryX=0;entryY=0.4;" edge="1" source="lambda-box" target="s3-2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-lam-s3err" value="PutObject (error marker)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;strokeColor=#b91c1c;fontColor=#b91c1c;exitX=1;exitY=0.7;entryX=0;entryY=0.85;" edge="1" source="lambda-box" target="s3-2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="lifecycle-note" value="⏱ S3 lifecycle rule: ALL objects in this bucket auto-expire after 1 day — input, output, and error markers alike (no manual cleanup needed)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#92400e;fontSize=10;fontStyle=2;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1160" height="34" as="geometry"/>
        </mxCell>

        <!-- ===== BAND 3: POLL & DOWNLOAD ===== -->

        <mxCell id="browser2" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;pollUntilDone(jobId)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1f36;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="668" width="140" height="64" as="geometry"/>
        </mxCell>

        <mxCell id="api2" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;getFilterMergeStatus()&lt;br&gt;downloadFilterMergeResult()"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#635bff;strokeColor=#4f46e5;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s3-3" value="S3" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="666" width="52" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="s3-3-detail" value="HeadObject output.xlsx → done&#xa;GetObject error.json → error&#xa;neither → still processing" style="text;html=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="668" width="230" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="e-b2-api" value="GET /filter-merge/:jobId/status&#xa;(every 3s)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" source="browser2" target="api2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-api2-b2" value="{ status: processing | done | error }" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;strokeColor=#059669;fontColor=#059669;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" source="api2" target="browser2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-api2-s3" value="HeadObject / GetObject" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#7AA116;fontColor=#7AA116;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="api2" target="s3-3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-b2-api-dl" value="GET /filter-merge/:jobId/download&#xa;(once status = done)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#635bff;strokeColor=#635bff;exitX=1;exitY=0.85;exitDx=0;exitDy=-6;entryX=0;entryY=0.85;entryDx=0;entryDy=-6;" edge="1" source="browser2" target="api2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-api-b2-stream" value="stream + Content-Disposition&#xa;(filename decoded from S3 metadata)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#635bff;fontColor=#635bff;exitX=0;exitY=0.95;exitDx=0;exitDy=-4;entryX=1;entryY=0.95;entryDx=0;entryDy=-4;" edge="1" source="api2" target="browser2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="iam-note" value="IAM — EC2 role: s3:PutObject/GetObject/HeadObject/DeleteObject on bucket + lambda:InvokeFunction on this function only.&#xa;Lambda role: s3:GetObject/PutObject on bucket only — no VPC, so no route to the EC2-hosted Postgres (never needs one)."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#c4cdd6;fontColor=#697386;fontSize=10;fontStyle=2;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1160" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 2 — Job Status States -->
  <diagram name="2. Job Status States" id="reconcile-status">
    <mxGraphModel dx="900" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="st-title" value="Job Status — no DB row, S3 object presence IS the state"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1a1f36;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="st-processing" value="processing&#xa;(neither object exists yet)"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e40af;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="st-done" value="done&#xa;output/{jobId}.xlsx exists"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#6ee7b7;fontColor=#065f46;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="st-error" value="error&#xa;output/{jobId}.xlsx.error.json exists"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;fontColor=#b91c1c;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="st-timeout" value="client-side timeout&#xa;(11 min of polling with no result)&#xa;→ shown as an error toast, job may still&#xa;finish server-side but is no longer awaited"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#92400e;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e-p-done" value="Lambda uploaded result" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#059669;fontColor=#059669;" edge="1" source="st-processing" target="st-done" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-p-error" value="Lambda uploaded error marker&#xa;(caught exception in handler.ts)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b91c1c;fontColor=#b91c1c;" edge="1" source="st-processing" target="st-error" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-p-timeout" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#f59e0b;" edge="1" source="st-processing" target="st-timeout" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="oom-note" value="⚠ True Lambda OOM/timeout (hard kill by the runtime) never reaches the catch block in handler.ts, so no error marker is written — the job just stays 'processing' forever from the API's point of view until the browser's own 11-minute poll timeout kicks in."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f3;strokeColor=#fecaca;fontColor=#df1b41;fontSize=10;fontStyle=2;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="250" height="120" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
