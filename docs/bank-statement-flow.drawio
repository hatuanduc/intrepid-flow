          <mxGeometry x="200" y="86" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rd-worker" value="Worker: run(jobId)&lt;br&gt;Loads steps from DB.&lt;br&gt;If step already 'completed'&lt;br&gt;→ skip it, load data from DB.&lt;br&gt;Run from first 'pending' step."
