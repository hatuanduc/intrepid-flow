<mxfile host="VSCode" version="21.0.8">
  <diagram id="architecture" name="1. Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="arch-title" value="Bank Statement Job — Architecture"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a1f36;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="arch-sub" value="3 separate OS processes: api  |  worker  |  redis  +  PostgreSQL"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#697386;fontStyle=2;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="520" height="24" as="geometry" />
        </mxCell>

        <!-- Process labels -->
        <mxCell id="pl-browser" value="process: browser tab"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#8898aa;fontStyle=2;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="108" width="130" height="18" as="geometry" />
        </mxCell>
        <mxCell id="pl-api" value="process: api"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#8898aa;fontStyle=2;"
          vertex="1" parent="1">
          <mxGeometry x="240" y="108" width="130" height="18" as="geometry" />
        </mxCell>
        <mxCell id="pl-redis" value="process: redis"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#8898aa;fontStyle=2;"
          vertex="1" parent="1">
          <mxGeometry x="460" y="108" width="130" height="18" as="geometry" />
        </mxCell>
        <mxCell id="pl-worker" value="process: worker"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#8898aa;fontStyle=2;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="108" width="150" height="18" as="geometry" />
        </mxCell>

        <!-- Browser -->
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;Next.js :3000"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1f36;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- API -->
        <mxCell id="api" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;NestJS :4000"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#635bff;strokeColor=#4f46e5;fontColor=#ffffff;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="240" y="130" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Redis -->
        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;Bull Queue&lt;br&gt;&quot;bank-sync&quot;"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;fontSize=12;boundedLbl=1;backgroundOutline=1;size=12;"
          vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="130" height="90" as="geometry" />
        </mxCell>

        <!-- Worker -->
        <mxCell id="worker" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;BankSyncProcessor"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1f36;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="130" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;bank_sync_jobs&lt;br&gt;bank_transactions&lt;br&gt;bank_accounts"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1f36;fontSize=12;boundedLbl=1;backgroundOutline=1;size=12;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="150" height="110" as="geometry" />
        </mxCell>

        <!-- Playwright -->
        <mxCell id="playwright" value="&lt;b&gt;Playwright Browser&lt;/b&gt;&lt;br&gt;headless Chromium"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1f36;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- HSBCnet -->
        <mxCell id="hsbc" value="&lt;b&gt;HSBCnet&lt;/b&gt;&lt;br&gt;(external website)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#c4cdd6;fontColor=#697386;fontSize=12;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="900" y="300" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Google Sheets -->
        <mxCell id="gsheets" value="&lt;b&gt;Google Sheets&lt;/b&gt;&lt;br&gt;(external API)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#c4cdd6;fontColor=#697386;fontSize=12;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="900" y="410" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->

        <!-- Browser → API -->
        <mxCell id="e1" value="POST trigger / retry / delete"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;"
          edge="1" source="browser" target="api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API → Browser SSE -->
        <mxCell id="e2" value="SSE stream (poll 2s)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;dashed=1;strokeColor=#635bff;fontColor=#635bff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;"
          edge="1" source="api" target="browser" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API → Redis -->
        <mxCell id="e3" value="queue.add('run', {jobId})"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="api" target="redis" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redis → Worker -->
        <mxCell id="e4" value="dispatch job"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="redis" target="worker" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API → DB (INSERT on trigger) -->
        <mxCell id="e5" value="INSERT job record"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;"
          edge="1" source="api" target="db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API → DB (SELECT for SSE) -->
        <mxCell id="e6" value="SELECT every 2s (SSE)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;dashed=1;strokeColor=#635bff;fontColor=#635bff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="api" target="db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker → DB (UPDATE status/logs) -->
        <mxCell id="e7" value="UPDATE status / logs / steps"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;"
          edge="1" source="worker" target="db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker → DB (INSERT transactions) -->
        <mxCell id="e8" value="INSERT bank_transactions"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#059669;fontColor=#059669;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;"
          edge="1" source="worker" target="db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker → Playwright -->
        <mxCell id="e9" value="drives automation"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="worker" target="playwright" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker → GSheets -->
        <mxCell id="e10" value="sync rows"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="worker" target="gsheets" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Playwright → HSBCnet -->
        <mxCell id="e11" value="headless browser"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="playwright" target="hsbc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

