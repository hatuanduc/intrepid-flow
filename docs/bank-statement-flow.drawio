        </mxCell>

        <mxCell id="rd-api" value="API: retryJob()&lt;br&gt;1. Validate status = failed&lt;br&gt;2. Reset steps to pending&lt;br&gt;3. job.status = pending&lt;br&gt;4. logs += __RETRY__&lt;br&gt;5. queue.add('run', {jobId})"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#c4b5fd;fontColor=#1a1f36;fontSize=11;align=left;spacingLeft=8;"
