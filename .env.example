# Không AWS — app chạy hoàn toàn trên Docker local (xem docker-compose.local.yml).
# docker-compose.local.yml tự đọc file .env ở ROOT repo này.
# Local dev (pnpm dev, không qua docker-compose.local.yml): api/worker cũng tự load qua dotenv.
# Never commit real values — copy file này thành .env ở root và fill in.

# ── Database ─────────────────────────────────────────────────────────────────
# docker-compose.local.yml: chỉ cần DB_PASSWORD — tự build DATABASE_URL từ giá trị này.
# Local dev (pnpm dev): api/worker chạy trực tiếp (ts-node-dev), không qua docker-compose.local.yml
# nên phải khai DATABASE_URL rõ ràng, khớp với credentials trong docker-compose.dev.yml
# (postgres chạy ở port 5433):
DATABASE_URL=postgresql://intrepid:intrepid@localhost:5433/intrepid
DB_PASSWORD=change_me_strong_password

# Seed admin email/password (mặc định 'adminintrepid@gmail.com' / 'intrepid' nếu bỏ trống — xem apps/api/src/prisma/seed.ts).
# Hosting cho nhiều người dùng thật: BẮT BUỘC đổi thành mật khẩu mạnh, không dùng giá trị mặc định.
SEED_ADMIN_EMAIL=adminintrepid@gmail.com
SEED_ADMIN_PASSWORD=intrepid

# Chỉ bật ở máy local — seed thêm 25 mock user để test pagination.
# Không set (hoặc set false) khi hosting cho người dùng thật — seed chỉ tạo đúng 1 account admin.
SEED_MOCK_USERS=true

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_64_char_random_string

# ── Redis (local dev — worker fallback về localhost:6379 nếu bỏ trống) ────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail: bật 2-Step Verification → tạo App Password tại myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # App Password (không phải mật khẩu Gmail thường)
SMTP_FROM=your.email@gmail.com

# ── Worker / Playwright ───────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true

# HSBCnet portal URL — bank-sync worker logs in vào đây để tải sao kê.
# Local dev: trỏ về mock-hsbc (giả lập HSBCnet) thay vì đăng nhập vào ngân hàng thật.
# Hosting thật (docker-compose.local.yml): bỏ trống hoặc không set — worker tự dùng
# default https://www1.secure.hsbcnet.com
HSBCNET_URL=http://localhost:3000/mock-hsbc

# ── Reconcile (apps/reconcile-lambda) — TẠM NGỪNG, không dùng AWS nữa ─────────
# Feature lọc/merge invoice phụ thuộc AWS Lambda + S3 (apps/reconcile-lambda) — đã bị
# ẩn khỏi sidebar và chặn ở API (ReconcileService.assertEnabled() trả 503) từ khi app
# ngừng chạy trên AWS. Không cần set gì ở đây; để trống là đủ để tính năng này tự "tắt".
# Settings/Master Customer của Reconcile (/settings/reconcile) KHÔNG phụ thuộc AWS, vẫn
# hoạt động bình thường dù không set 2 biến dưới.
# RECONCILE_BUCKET=
# RECONCILE_LAMBDA_NAME=

# ── Bank statement PDF export (apps/worker + apps/api) ─────────────────────────
# Local-disk mirror của PDF giao dịch đã upload lên Google Drive (xem BankDriveExportConfig)
# — cho app tự serve/xem PDF mà không phụ thuộc quyền share folder Drive.
# Trước đây là S3 bucket (AWS) — giờ là 1 đường dẫn, phải TRÙNG NHAU giữa container `api`
# và `worker` và phải nằm trên 1 Docker volume dùng chung (xem docker-compose.local.yml:
# volume bank_statement_pdfs mount vào đúng path này ở cả 2 container).
BANK_STATEMENT_PDF_DIR=/data/bank-statement-pdfs

# ── URLs ──────────────────────────────────────────────────────────────────────
# Domain thật trỏ qua Cloudflare Tunnel (xem CLOUDFLARE_TUNNEL_TOKEN bên dưới) — không
# phải domain của Cloudflare, mà là domain riêng của bạn (vd pavietnam) đã add vào Cloudflare.
APP_URL=https://app.your-domain.com
# Baked into the web Docker image AT BUILD TIME (Next.js NEXT_PUBLIC_* vars) — khi dùng
# image build sẵn từ GHCR (xem .github/workflows/pipeline.yml), giá trị này phải được set
# làm GitHub Actions repo Variable (NEXT_PUBLIC_API_BASE_URL) TRƯỚC khi build image, set
# ở đây không có tác dụng gì với image đã build sẵn — chỉ dùng khi tự build lại bằng
# `docker compose -f docker-compose.local.yml build`.
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com

# ── Google OAuth (Sign in with Google) ─────────────────────────────────────────
# Tạo OAuth 2.0 Client ID (type: Web application) trên Google Cloud Console.
# Authorized JavaScript origins: http://localhost:3000 + domain thật — KHÔNG cần
# redirect URI hay client secret (dùng GIS ID-token flow, không phải authorization code).
# Cùng 1 giá trị dùng cho cả api (verify token) và web (build arg NEXT_PUBLIC_GOOGLE_CLIENT_ID
# — xem lưu ý ở NEXT_PUBLIC_API_BASE_URL phía trên, áp dụng y hệt cho biến này).
# Local dev: Next.js chỉ đọc apps/web/.env(.local), không đọc .env ở root — nên còn cần
# thêm dòng NEXT_PUBLIC_GOOGLE_CLIENT_ID=<cùng giá trị> vào apps/web/.env.local.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── Cloudflare Tunnel (expose app ra domain thật, không cần port-forward) ──────
# Tạo 1 lần trong Cloudflare Zero Trust dashboard (Networks → Tunnels → Create a tunnel),
# map public hostname → service nội bộ ngay trong dashboard đó (vd app.your-domain.com →
# http://web:3000, api.your-domain.com → http://api:4000 — dùng tên service trong
# docker-compose.local.yml, không phải localhost, vì cloudflared chạy chung network Docker).
# Token lấy ở bước "Install connector" của tunnel đó.
CLOUDFLARE_TUNNEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
