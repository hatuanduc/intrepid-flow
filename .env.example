# ── Database ─────────────────────────────────────────────────────────────────
# Pooled connection — runtime (api + worker)
DATABASE_URL=postgresql://user:password@host:6543/postgres?schema=public&pgbouncer=true
# Direct connection — migrate/generate
DIRECT_URL=postgresql://user:password@host:5432/postgres?schema=public

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API ───────────────────────────────────────────────────────────────────────
PORT=4000

# ── Worker / Playwright ───────────────────────────────────────────────────────
HSBCNET_USERNAME=
PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_SLOW_MO=600   # ms delay giữa mỗi action — bật khi debug (headless=false tự dùng 600ms)

# Mock mode: point worker at the local Next.js mock instead of real HSBC
# HSBCNET_URL=http://localhost:3000/mock-hsbc

# ── Email / SMTP (dùng cho invite user) ──────────────────────────────────────
# Gmail: bật 2-Step Verification → tạo App Password tại myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # App Password (không phải mật khẩu Gmail thường)
SMTP_FROM=your.email@gmail.com  # Địa chỉ người gửi (thường giống SMTP_USER)
APP_URL=http://localhost:3000   # URL frontend — dùng trong link invite email
