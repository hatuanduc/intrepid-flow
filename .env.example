# /app/.env on EC2 — docker-compose.prod.yml reads this automatically
# Never commit real values — copy this to /app/.env on the server and fill in

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL password (used by the db container and to construct DATABASE_URL)
DB_PASSWORD=change_me_strong_password

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_64_char_random_string

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail: bật 2-Step Verification → tạo App Password tại myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # App Password (không phải mật khẩu Gmail thường)
SMTP_FROM=your.email@gmail.com

# ── Worker / Playwright ───────────────────────────────────────────────────────
HSBCNET_USERNAME=
PLAYWRIGHT_HEADLESS=true

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=https://your-domain.com
# Baked into the web Docker image at build time (Next.js NEXT_PUBLIC_* vars)
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
