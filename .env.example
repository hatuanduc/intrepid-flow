# /app/.env on EC2 — docker-compose.prod.yml reads this automatically
# Local dev: copy this to /.env ở ROOT repo — apps/api và apps/worker tự load qua dotenv
APP_ENV=dev   # hoặc prod — dùng để phân biệt CloudWatch log group
# Never commit real values — copy this to /app/.env on the server (prod) hoặc .env ở root (dev) và fill in

# ── Database ─────────────────────────────────────────────────────────────────
# Prod: chỉ cần DB_PASSWORD — docker-compose.prod.yml tự build DATABASE_URL từ giá trị này.
# Local dev: api/worker chạy trực tiếp (ts-node-dev), không qua docker-compose nên phải khai DATABASE_URL rõ ràng,
# khớp với credentials trong docker-compose.dev.yml (postgres chạy ở port 5433):
DATABASE_URL=postgresql://intrepid:intrepid@localhost:5433/intrepid
DB_PASSWORD=change_me_strong_password

# Seed admin email/password (mặc định 'adminintrepid@gmail.com' / 'intrepid' nếu bỏ trống — xem apps/api/src/prisma/seed.ts).
# Prod/dev deploy: BẮT BUỘC đổi thành mật khẩu mạnh, không dùng giá trị mặc định.
SEED_ADMIN_EMAIL=adminintrepid@gmail.com
SEED_ADMIN_PASSWORD=intrepid

# Chỉ bật ở máy local — seed thêm 25 mock user để test pagination.
# Không set (hoặc set false) ở dev/prod deploy — seed chỉ tạo đúng 1 account admin.
SEED_MOCK_USERS=true

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_64_char_random_string

# ── Redis (local dev — worker fallback về localhost:6379 nếu bỏ trống) ────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail: bật 2-Step Verification → tạo App Password tại myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # App Password (không phải mật khẩu Gmail thường)
SMTP_FROM=your.email@gmail.com

# ── Worker / Playwright ───────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true

# HSBCnet portal URL — bank-sync worker logs in vào đây để tải sao kê.
# Local dev: trỏ về mock-hsbc (giả lập HSBCnet) thay vì đăng nhập vào ngân hàng thật.
# Prod: bỏ trống hoặc không set — worker tự dùng default https://www1.secure.hsbcnet.com
HSBCNET_URL=http://localhost:3000/mock-hsbc

# ── Reconcile Lambda (apps/reconcile-lambda) ──────────────────────────────────
# Prod/dev deploy: KHÔNG cần set — EC2 instance role tự lấy credentials qua IMDSv2,
# và deploy.sh tự pull 3 biến này từ SSM /intrepid/{env}/... vào /app/.env.
# Local dev: BẮT BUỘC set cả 3 để test được — apps/api gọi thẳng S3 + Lambda thật của
# env đó (không có mock local), nên cần:
#   1. AWS credentials cục bộ có quyền s3:Put/Get/Head/DeleteObject + lambda:InvokeFunction
#      trên bucket/function bên dưới (dùng chung IAM user "intrepid-deploy" ở README này
#      nếu đã có, vì user đó vốn đã có AWSLambda_FullAccess + AmazonS3FullAccess).
#   2. Giá trị BUCKET/LAMBDA_NAME lấy từ `terraform output reconcile_bucket` và
#      `terraform output reconcile_lambda_name` (chạy trong infra/aws/environments/dev sau khi apply).
AWS_REGION=ap-southeast-1
RECONCILE_BUCKET=intrepid-flow-dev-reconcile
RECONCILE_LAMBDA_NAME=intrepid-flow-dev-reconcile

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=https://your-domain.com
# Baked into the web Docker image at build time (Next.js NEXT_PUBLIC_* vars)
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
