{
  "name": "intrepid",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @intrepid/api dev\" \"pnpm --filter @intrepid/web dev\" \"pnpm --filter @intrepid/worker dev\"",
    "dev:api": "pnpm --filter @intrepid/api dev",
    "dev:web": "pnpm --filter @intrepid/web dev",
    "dev:worker": "pnpm --filter @intrepid/worker dev",
    "build": "pnpm --filter @intrepid/api build && pnpm --filter @intrepid/web build",
    "start": "pnpm --filter @intrepid/api start",
    "lint": "pnpm --filter @intrepid/web lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx apps/api/src/prisma/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "concurrently": "^9.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.0.0"
  }
}
